generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model mentee {
  id              Int               @id @default(autoincrement())
  sub_google_id   String            @unique
  username        String            @db.VarChar(255)
  email           String            @unique @db.VarChar(225)
  password        String?           @db.Text
  status          mentee_status?
  address         String?           @db.VarChar(225)
  gender          gender?
  mentee_progress mentee_progress[]
}

model admin {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(225)
  password String @db.VarChar(225)
}

model mentor {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(50)
  id_campus         Int
  id_major          Int
  password          String?             @db.Text
  nik               Int                 @unique(map: "nik")
  course_instructor course_instructor[]
  campus            campus              @relation(fields: [id_campus], references: [id], onDelete: Cascade, map: "mentor_ibfk_1")
  major             major               @relation(fields: [id_major], references: [id], onDelete: Cascade, map: "mentor_ibfk_2")

  @@index([id_campus, id_major], map: "id_campus")
  @@index([id_major], map: "id_major")
}

model campus {
  id                  Int                        @id @default(autoincrement())
  campus_name         String?                    @db.VarChar(225)
  email               String                     @db.VarChar(225)
  password            String?                    @db.Text
  address             String?                    @db.VarChar(225)
  description         String?                    @db.Text
  verification_status verification_status_campus
  sub_google_id       String                     @unique
  major               major[]
  mentor              mentor[]
}

model standard_major {
  id          Int     @id @default(autoincrement())
  major_name  String  @db.VarChar(225)
  description String  @db.Text
  major       major[]
}

model major {
  id                Int            @id @default(autoincrement())
  id_campus         Int
  id_standard_major Int
  campus            campus         @relation(fields: [id_campus], references: [id], onDelete: Cascade, map: "major_ibfk_1")
  standard_major    standard_major @relation(fields: [id_standard_major], references: [id], onDelete: Cascade, map: "major_ibfk_2")
  mentor            mentor[]

  @@index([id_campus, id_standard_major], map: "id_campus")
  @@index([id_standard_major], map: "id_standard_major")
}

model program {
  id              Int               @id @default(autoincrement())
  program_name    String            @db.VarChar(225)
  description     String            @db.Text
  start_date      DateTime          @db.Date
  end_date        DateTime          @db.Date
  create_at       DateTime          @db.Timestamp(0)
  update_at       DateTime          @db.Timestamp(0)
  materi          materi[]
  mentee_progress mentee_progress[]
  sesi_program    sesi_program[]
}

model course_instructor {
  id        Int    @id @default(autoincrement())
  id_mentor Int
  id_materi Int
  mentor    mentor @relation(fields: [id_mentor], references: [id], onDelete: Cascade, map: "course_instructor_ibfk_1")
  materi    materi @relation(fields: [id_materi], references: [id], onDelete: Cascade, map: "course_instructor_ibfk_2")

  @@index([id_materi], map: "id_materi")
  @@index([id_mentor, id_materi], map: "id_mentor")
}

model materi {
  id                Int                 @id @default(autoincrement())
  title             String              @db.VarChar(60)
  type              type_materi
  description       String              @db.Text
  create_at         DateTime            @db.Timestamp(0)
  update_at         DateTime            @db.Timestamp(0)
  visibility        visibility_materi
  id_program        Int
  course_instructor course_instructor[]
  program           program             @relation(fields: [id_program], references: [id], onDelete: Cascade, map: "materi_ibfk_1")

  @@index([id_program], map: "id_mentor")
}

model mentee_progress {
  id                Int                        @id @default(autoincrement())
  completion_status completion_status_progress
  completion_date   DateTime                   @db.Timestamp(0)
  final_score       Int
  id_mentee         Int
  id_program        Int
  mentee            mentee                     @relation(fields: [id_mentee], references: [id], onDelete: Cascade, map: "mentee_progress_ibfk_1")
  program           program                    @relation(fields: [id_program], references: [id], onDelete: Cascade, map: "mentee_progress_ibfk_2")

  @@index([id_mentee], map: "id_mentee")
  @@index([id_program], map: "id_program")
}

model sesi_program {
  id          Int      @id @default(autoincrement())
  type_sesi   sesi
  description String   @db.VarChar(225)
  sesi_date   DateTime
  id_program  Int
  program     program  @relation(fields: [id_program], references: [id], onDelete: Cascade, map: "sesi_program_ibfk_1")

  @@index([id_program], map: "id_program")
}

enum completion_status_progress {
  completed
  uncomplate
}

enum visibility_materi {
  private
  public
}

enum type_materi {
  file
  video
  kuis
}

enum sesi {
  online
  offline
}

enum verification_status_campus {
  accepted
  pending
  rejected
}

enum gender {
  Male
  Female
}

enum mentee_status {
  Active
  Non_Active @map("Non-Active")
}
