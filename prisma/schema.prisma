generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model mentee {
  id                   Int                    @id @default(autoincrement())
  sub_google_id        String                 @unique
  username             String                 @db.VarChar(255)
  email                String                 @unique @db.VarChar(225)
  password             String?                @db.Text
  status               mentee_status?
  address              String?                @db.VarChar(225)
  gender               gender?
  mentee_progress      mentee_progress[]
  recomendation_majors recomendation_majors[]
}

model admin {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(225)
  password String @db.VarChar(225)
}

model mentor {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(50)
  id_campus         Int
  id_major          Int
  password          String?             @db.Text
  nik               Int                 @unique(map: "nik")
  course_instructor course_instructor[]
  campus            campus              @relation(fields: [id_campus], references: [id], onDelete: Cascade, map: "mentor_ibfk_1")
  major             major               @relation(fields: [id_major], references: [id], onDelete: Cascade, map: "mentor_ibfk_2")
  program           program[]

  @@index([id_campus, id_major], map: "id_campus")
  @@index([id_major], map: "id_major")
}

model campus {
  id                                Int                        @id @default(autoincrement())
  campus_name                       String?                    @db.VarChar(225)
  email                             String                     @db.VarChar(225)
  password                          String?                    @db.Text
  path_logo                         String?                    @db.Text
  path_banner                       String?                    @db.Text
  address                           String?                    @db.VarChar(225)
  description                       String?                    @db.Text
  vision_mission                    Json
  email_campus                      String?                    @db.VarChar(225)
  website_campus                    String?                    @db.VarChar(225)
  province                          String?                    @db.VarChar(225)
  city                              String?                    @db.VarChar(225)
  subdistrict                       String?                    @db.VarChar(225)
  ward                              String?                    @db.VarChar(225)
  lat                               Float?                     @db.Float
  lng                               Float?                     @db.Float
  verification_status               campus_verification_status
  sub_google_id                     String                     @unique
  major                             major[]
  mentor                            mentor[]
  program_program_id_campusTocampus program[]                  @relation("program_id_campusTocampus")
}

model standard_major {
  id            Int     @id @default(autoincrement())
  major_name    String  @db.VarChar(225)
  description   String? @db.Text
  prospek_kerja Json?
  major         major[]
}

model major {
  id                               Int            @id @default(autoincrement())
  id_campus                        Int
  id_standard_major                Int
  campus                           campus         @relation(fields: [id_campus], references: [id], onDelete: Cascade, map: "major_ibfk_1")
  standard_major                   standard_major @relation(fields: [id_standard_major], references: [id], onDelete: Cascade, map: "major_ibfk_2")
  mentor                           mentor[]
  program_program_id_majorTocampus program[]      @relation("program_id_majorTocampus")

  @@index([id_campus, id_standard_major], map: "id_campus")
  @@index([id_standard_major], map: "id_standard_major")
}

model program {
  id                               Int                    @id @default(autoincrement())
  program_name                     String                 @db.VarChar(225)
  description                      String                 @db.Text
  start_date                       DateTime               @db.Date
  end_date                         DateTime               @db.Date
  create_at                        DateTime               @db.Timestamp(0)
  update_at                        DateTime               @db.Timestamp(0)
  capacity                         Int
  program_status                   program_program_status
  id_campus                        Int
  id_mentor                        Int
  id_major                         Int
  path_gambar                      String?                @db.Text
  benefit                          Json
  terms_and_conditions             Json
  type_sesi                        program_type_sesi
  sesi_description                 String                 @db.VarChar(225)
  sesi_start                       DateTime               @db.Time(0)
  sesi_end                         DateTime               @db.Time(0)
  visibility                       program_visibility?
  lat                              Float?                 @db.Float
  lng                              Float?                 @db.Float
  materi                           materi[]
  mentee_progress                  mentee_progress[]
  mentor                           mentor                 @relation(fields: [id_mentor], references: [id], onDelete: NoAction, map: "program_ibfk_1")
  campus_program_id_campusTocampus campus                 @relation("program_id_campusTocampus", fields: [id_campus], references: [id], onDelete: Cascade, map: "program_ibfk_2")
  campus_program_id_majorTocampus  major                  @relation("program_id_majorTocampus", fields: [id_major], references: [id], onDelete: Cascade, map: "program_ibfk_3")
  sesi_program                     sesi_program[]

  @@index([id_campus, id_mentor], map: "id_campus")
  @@index([id_major], map: "id_major")
  @@index([id_mentor], map: "id_mentor")
}

model course_instructor {
  id        Int    @id @default(autoincrement())
  id_mentor Int
  id_materi Int
  mentor    mentor @relation(fields: [id_mentor], references: [id], onDelete: Cascade, map: "course_instructor_ibfk_1")
  materi    materi @relation(fields: [id_materi], references: [id], onDelete: Cascade, map: "course_instructor_ibfk_2")

  @@index([id_materi], map: "id_materi")
  @@index([id_mentor, id_materi], map: "id_mentor")
}

model materi {
  id                Int                 @id @default(autoincrement())
  title             String              @db.VarChar(60)
  description       String              @db.Text
  create_at         DateTime            @db.Timestamp(0)
  update_at         DateTime            @db.Timestamp(0)
  visibility        visibility_materi
  id_program        Int
  course_instructor course_instructor[]
  program           program             @relation(fields: [id_program], references: [id], onDelete: Cascade, map: "materi_ibfk_1")
  materi_resource   materi_resource[]

  @@index([id_program], map: "id_mentor")
}

model mentee_progress {
  id                Int                               @id @default(autoincrement())
  completion_status mentee_progress_completion_status
  completion_date   DateTime?                         @db.Timestamp(0)
  final_score       Int?
  id_mentee         Int
  id_program        Int
  mentee            mentee                            @relation(fields: [id_mentee], references: [id], onDelete: Cascade, map: "mentee_progress_ibfk_1")
  program           program                           @relation(fields: [id_program], references: [id], onDelete: Cascade, map: "mentee_progress_ibfk_2")

  @@index([id_mentee], map: "id_mentee")
  @@index([id_program], map: "id_program")
}

model sesi_program {
  id          Int                    @id @default(autoincrement())
  type_sesi   sesi_program_type_sesi
  description String                 @db.VarChar(225)
  sesi_date   DateTime
  id_program  Int
  program     program                @relation(fields: [id_program], references: [id], onDelete: Cascade, map: "sesi_program_ibfk_1")

  @@index([id_program], map: "id_program")
}

model recomendation_majors {
  id          Int    @id @default(autoincrement())
  response_ai Json?
  id_mentee   Int
  mentee      mentee @relation(fields: [id_mentee], references: [id], onDelete: Cascade, map: "recomendation_majors_ibfk_1")

  @@index([id_mentee], map: "id_mentee")
}

model materi_resource {
  id        Int                  @id @default(autoincrement())
  type      materi_resource_type
  path_file String               @db.Text
  id_materi Int
  materi    materi               @relation(fields: [id_materi], references: [id], onDelete: Cascade, map: "materi_resource_ibfk_1")

  @@index([id_materi], map: "id_materi")
}

enum visibility_materi {
  private
  public
}

enum gender {
  Male
  Female
}

enum mentee_status {
  Active
  Non_Active @map("Non-Active")
}

enum mentee_progress_completion_status {
  completed
  on_going    @map("on going")
  uncompleted
}

enum program_program_status {
  open
  closed
}

enum sesi_program_type_sesi {
  online
  onsite
}

enum program_type_sesi {
  online
  onsite
}

enum materi_resource_type {
  file
  kuis
  video
}

enum campus_verification_status {
  accepted
  pending
  rejected
  null
}

enum program_visibility {
  private
  public
}
